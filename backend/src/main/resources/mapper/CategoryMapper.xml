<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.backend.category.mapper.CategoryMapper">
    <resultMap id="categoryResultMap" type="com.study.backend.category.model.Category">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="getCategories" resultMap="categoryResultMap">
        SELECT id,
               category_name AS name
        FROM category
        WHERE category_type = #{categoryType}
        ORDER BY id
    </select>

    <select id="existsByIdAndType" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM category
            WHERE id = #{categoryId}
              AND category_type = #{categoryType}
        )
    </select>
</mapper>
